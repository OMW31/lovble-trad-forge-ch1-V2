INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q1', 'analyse-fondamentale', 'intro', 1, 'L''analyse fondamentale cherche à déterminer :', '[{"id":"a","label":"La tendance technique du marché"},{"id":"b","label":"La valeur intrinsèque d''un actif"},{"id":"c","label":"Les volumes de transactions"},{"id":"d","label":"La volatilité future"}]'::jsonb, 'b', 'Elle se base sur les facteurs économiques et financiers pour évaluer la « juste valeur ».', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q2', 'analyse-fondamentale', 'intro', 1, 'Selon l''analyse fondamentale, le prix de marché :', '[{"id":"a","label":"Coïncide toujours avec la valeur intrinsèque"},{"id":"b","label":"Peut s''écarter temporairement de la valeur intrinsèque"},{"id":"c","label":"Est indépendant des fondamentaux"},{"id":"d","label":"Détermine la valeur intrinsèque"}]'::jsonb, 'b', 'Les marchés ne sont pas parfaitement efficients ; des divergences apparaissent.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q3', 'analyse-fondamentale', 'intro', 1, 'Un des principes clés de l''analyse fondamentale est :', '[{"id":"a","label":"L''efficience absolue des marchés"},{"id":"b","label":"Le retour à la moyenne à long terme"},{"id":"c","label":"L''absence de risque"},{"id":"d","label":"L''analyse des seuls graphiques"}]'::jsonb, 'b', 'On s''attend à ce que le prix converge vers la valeur intrinsèque à long terme.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q4', 'analyse-fondamentale', 'intro', 1, 'L''analyse fondamentale est particulièrement utile pour :', '[{"id":"a","label":"Le trading haute fréquence"},{"id":"b","label":"Les stratégies d''investissement à long terme"},{"id":"c","label":"La détection de supports/résistances"},{"id":"d","label":"L''analyse des chandeliers"}]'::jsonb, 'b', 'Elle se concentre sur les moteurs de valeur sur la durée.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q5', 'analyse-fondamentale', 'intro', 1, 'Lequel n''est PAS un objectif de l''analyse fondamentale ?', '[{"id":"a","label":"Identifier les actifs surévalués"},{"id":"b","label":"Comprendre les moteurs du marché"},{"id":"c","label":"Prédire le prix à 5 minutes"},{"id":"d","label":"Gérer les risques"}]'::jsonb, 'c', 'L''AF n''a pas vocation à prévoir les mouvements de très court terme.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q6', 'analyse-fondamentale', 'intro', 2, 'La valeur intrinsèque repose sur :', '[{"id":"a","label":"Les rumeurs de marché"},{"id":"b","label":"Les facteurs économiques, financiers et qualitatifs"},{"id":"c","label":"Le sentiment des investisseurs"},{"id":"d","label":"Les ordres de bourse"}]'::jsonb, 'b', 'Elle est basée sur une analyse approfondie des fondamentaux.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q7', 'analyse-fondamentale', 'intro', 2, 'L''hypothèse d''efficience des marchés est :', '[{"id":"a","label":"Totalement vraie dans tous les cas"},{"id":"b","label":"Remise en cause par l''analyse fondamentale"},{"id":"c","label":"Sans importance pour l''investisseur"},{"id":"d","label":"Une loi mathématique"}]'::jsonb, 'b', 'L''analyse fondamentale postule que les marchés ne sont pas toujours efficients.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q8', 'analyse-fondamentale', 'intro', 2, 'Le principe de « retour à la moyenne » implique que :', '[{"id":"a","label":"Les prix ne reviennent jamais à leur moyenne"},{"id":"b","label":"Les prix tendent à revenir vers leur valeur intrinsèque"},{"id":"c","label":"La moyenne est toujours inférieure au prix"},{"id":"d","label":"Le prix moyen est la seule référence"}]'::jsonb, 'b', 'C''est l''un des piliers de l''analyse fondamentale.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q9', 'analyse-fondamentale', 'intro', 1, 'L''analyse fondamentale s''oppose à l''analyse technique car :', '[{"id":"a","label":"Elle utilise des graphiques"},{"id":"b","label":"Elle s''intéresse aux causes sous-jacentes"},{"id":"c","label":"Elle est moins fiable"},{"id":"d","label":"Elle ne s''applique qu''aux actions"}]'::jsonb, 'b', 'L''AT se concentre sur les prix et volumes, l''AF sur les fondamentaux.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q10', 'analyse-fondamentale', 'intro', 1, 'Un investisseur qui utilise l''analyse fondamentale cherche à :', '[{"id":"a","label":"Profiter des fluctuations de très court terme"},{"id":"b","label":"Exploiter les écarts entre prix et valeur intrinsèque"},{"id":"c","label":"Suivre les tendances des graphiques"},{"id":"d","label":"Ignorer les données économiques"}]'::jsonb, 'b', 'L''objectif est d''acheter sous-évalué et vendre surévalué.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q11', 'analyse-fondamentale', 'intro', 1, 'La « valeur intrinsèque » d''une devise dépend notamment :', '[{"id":"a","label":"Des ordres de bourse"},{"id":"b","label":"De la santé économique du pays émetteur"},{"id":"c","label":"Du nombre de transactions"},{"id":"d","label":"De la météo"}]'::jsonb, 'b', 'La santé économique (PIB, inflation, etc.) détermine la valeur d''une devise.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q12', 'analyse-fondamentale', 'intro', 2, 'Pourquoi l''analyse fondamentale est-elle importante pour la gestion des risques ?', '[{"id":"a","label":"Elle permet d''éviter toute perte"},{"id":"b","label":"Elle identifie les actifs soutenus par des fondamentaux solides"},{"id":"c","label":"Elle garantit des rendements élevés"},{"id":"d","label":"Elle est sans risque"}]'::jsonb, 'b', 'En connaissant la solidité des fondamentaux, on peut mieux évaluer le risque.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q13', 'analyse-fondamentale', 'intro', 3, 'L''analyse fondamentale est particulièrement adaptée aux marchés :', '[{"id":"a","label":"Peu liquides"},{"id":"b","label":"Où les prix sont toujours justes"},{"id":"c","label":"Où des inefficiences peuvent exister"},{"id":"d","label":"Où l''information est parfaite"}]'::jsonb, 'c', 'Les inefficiences créent des opportunités pour l''AF.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q14', 'analyse-fondamentale', 'intro', 3, 'La valeur intrinsèque d''une entreprise est souvent estimée via :', '[{"id":"a","label":"Les cours de bourse"},{"id":"b","label":"Les flux de trésorerie futurs actualisés"},{"id":"c","label":"Les volumes de transactions"},{"id":"d","label":"Les rumeurs"}]'::jsonb, 'b', 'Le modèle DCF est l''un des plus utilisés.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.1-Q15', 'analyse-fondamentale', 'intro', 3, 'Dans l''analyse fondamentale, la « convergence vers la valeur intrinsèque » :', '[{"id":"a","label":"Est instantanée"},{"id":"b","label":"Peut prendre du temps"},{"id":"c","label":"N''arrive jamais"},{"id":"d","label":"Dépend des algorithmes"}]'::jsonb, 'b', 'Les marchés peuvent rester irrationnels longtemps.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q1', 'analyse-fondamentale', 'macro', 1, 'Une hausse surprise du PIB américain est généralement :', '[{"id":"a","label":"Négative pour l''USD"},{"id":"b","label":"Positive pour l''USD"},{"id":"c","label":"Neutre"},{"id":"d","label":"Impossible à anticiper"}]'::jsonb, 'b', 'Une croissance robuste attire les capitaux et peut maintenir les taux élevés.', true);
