INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.1-WQ6', 'analyse-fondamentale', 'intro', 2, 'Dans le MarketDriverVisualizer, si le driver sélectionné est « NFP fort », le canal de transmission vers l''USD est :', '[{"id":"a","label":"Politique fiscale"},{"id":"b","label":"Politique monétaire (taux réels, anticipations Fed)"},{"id":"c","label":"Balance commerciale"},{"id":"d","label":"Rien, le NFP n''impacte pas l''USD"}]'::jsonb, 'b', 'NFP fort → Fed hawkish → taux ↑ → USD ↑.', 'MarketDriverVisualizer', 'a17', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.1-WQ7', 'analyse-fondamentale', 'intro', 2, 'Le MacroRegimeRadar utilise un polygone à 6 axes. Lequel de ces axes n''est PAS affiché ?', '[{"id":"a","label":"PIB"},{"id":"b","label":"Inflation"},{"id":"c","label":"Taux directeurs"},{"id":"d","label":"Dividendes"}]'::jsonb, 'd', 'Les 6 axes sont : PIB, IPC, Taux, Liquidité, Sentiment, Crédit.', 'MacroRegimeRadar', 'a11', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.1-WQ8', 'analyse-fondamentale', 'intro', 3, 'Si le radar indique un score élevé sur « Inflation » et « Taux », mais faible sur « PIB », le régime probable est :', '[{"id":"a","label":"Expansion"},{"id":"b","label":"Stagflation"},{"id":"c","label":"Goldilocks"},{"id":"d","label":"Récession pure"}]'::jsonb, 'b', 'Inflation haute + croissance faible = Stagflation.', 'MacroRegimeRadar', 'a11', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.1-WQ9', 'analyse-fondamentale', 'intro', 3, 'Dans le MarketDriverVisualizer, l''invalidation d''un driver « PIB fort » pourrait être :', '[{"id":"a","label":"Une révision à la baisse du PIB"},{"id":"b","label":"Une hausse des salaires"},{"id":"c","label":"Une baisse du chômage"},{"id":"d","label":"Un excédent commercial"}]'::jsonb, 'a', 'Si le PIB est révisé à la baisse, la thèse de croissance forte s''effondre.', 'MarketDriverVisualizer', 'a17', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.1-WQ10', 'analyse-fondamentale', 'intro', 3, 'Pourquoi le MacroRegimeRadar est-il plus utile qu''un indicateur macro isolé ?', '[{"id":"a","label":"Parce qu''il est plus coloré"},{"id":"b","label":"Parce qu''il force la lecture multi-dimensionnelle (croisement de plusieurs facteurs)"},{"id":"c","label":"Parce qu''il prédit le cours exact"},{"id":"d","label":"Parce qu''il remplace l''analyse technique"}]'::jsonb, 'b', 'La macro est multi-factorielle ; le radar évite le diagnostic mono-variable.', 'MacroRegimeRadar', 'a11', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ1', 'analyse-fondamentale', 'macro', 1, 'Le MacroDashboard affiche 11 indicateurs sous forme de :', '[{"id":"a","label":"Graphique linéaire unique"},{"id":"b","label":"Tuiles synthèse (Réel / Consensus / Précédent)"},{"id":"c","label":"Tableau Excel"},{"id":"d","label":"Carte géographique"}]'::jsonb, 'b', 'C''est un command center avec filtres par catégorie et modal détail.', 'MacroDashboard', 'a5', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ2', 'analyse-fondamentale', 'macro', 1, 'Dans l''EconomicCycleWheel, la phase « Récession » favorise généralement :', '[{"id":"a","label":"Les actions cycliques"},{"id":"b","label":"L''or et les obligations souveraines"},{"id":"c","label":"Les devises des marchés émergents"},{"id":"d","label":"Les matières premières industrielles"}]'::jsonb, 'b', 'Récession = fuite vers la qualité (safe havens).', 'EconomicCycleWheel', 'a1', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ3', 'analyse-fondamentale', 'macro', 1, 'Le FedSimulator utilise deux sliders principaux :', '[{"id":"a","label":"PIB et balance commerciale"},{"id":"b","label":"CPI et NFP"},{"id":"c","label":"Or et pétrole"},{"id":"d","label":"Actions et obligations"}]'::jsonb, 'b', 'La matrice décision Fed croise inflation et emploi.', 'FedSimulator', 'a1', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ4', 'analyse-fondamentale', 'macro', 2, 'Dans le NfpInterpreter, une surprise de +2σ (sigma) est interprétée comme :', '[{"id":"a","label":"Un bruit statistique"},{"id":"b","label":"Un signal fort susceptible de déclencher une réaction Fed"},{"id":"c","label":"Sans impact sur les marchés"},{"id":"d","label":"Un indicateur retardé"}]'::jsonb, 'b', '>2σ = magnitude exceptionnelle = réaction institutionnelle probable.', 'NfpInterpreter', 'a4', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ5', 'analyse-fondamentale', 'macro', 2, 'Le YieldCurveVisualizer affiche une courbe « inversée » quand :', '[{"id":"a","label":"Les taux longs sont supérieurs aux taux courts"},{"id":"b","label":"Les taux courts sont supérieurs aux taux longs (ex: 2Y > 10Y)"},{"id":"c","label":"Tous les taux sont nuls"},{"id":"d","label":"La Fed baisse les taux"}]'::jsonb, 'b', 'Inversion 2Y/10Y = signal récession classique.', 'YieldCurveVisualizer', 'a14', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ6', 'analyse-fondamentale', 'macro', 2, 'Dans le GdpCpiInterpreters, la combinaison PIB fort + CPI bas correspond au régime :', '[{"id":"a","label":"Stagflation"},{"id":"b","label":"Goldilocks"},{"id":"c","label":"Récession"},{"id":"d","label":"Hyperinflation"}]'::jsonb, 'b', 'Croissance saine + inflation maîtrisée = environnement idéal.', 'GdpCpiInterpreters', 'a1', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ7', 'analyse-fondamentale', 'macro', 2, 'L''IntermarketCorrelationMap affiche une corrélation négative (rouge) entre DXY et EUR/USD. Cela signifie :', '[{"id":"a","label":"Quand le dollar monte, l''euro tend à baisser"},{"id":"b","label":"Les deux montent ensemble"},{"id":"c","label":"Aucun lien entre les deux"},{"id":"d","label":"La corrélation est décorative"}]'::jsonb, 'a', 'Corrélation négative = mouvements inverses.', 'IntermarketCorrelationMap', 'a13', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ8', 'analyse-fondamentale', 'macro', 2, 'Dans le MacroIndicatorLab, la « surprise » est calculée comme :', '[{"id":"a","label":"Consensus − Réel"},{"id":"b","label":"Réel − Consensus"},{"id":"c","label":"Réel + Consensus"},{"id":"d","label":"Réel / Consensus"}]'::jsonb, 'b', 'Surprise = Réel − Consensus (beat si > 0, miss si < 0).', 'MacroIndicatorLab', 'a2', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ9', 'analyse-fondamentale', 'macro', 2, 'Le MacroRelationshipEngine affiche une chaîne : CPI ↑ → Fed hawkish → USD ↑. Le mécanisme de transmission est :', '[{"id":"a","label":"La politique monétaire restrictive renforce la devise"},{"id":"b","label":"L''inflation affaiblit toujours la devise"},{"id":"c","label":"La Fed achète des devises"},{"id":"d","label":"Le USD monte sans raison"}]'::jsonb, 'a', 'Hawkish = taux ↑ → attrait des capitaux → devise ↑.', 'MacroRelationshipEngine', 'a2', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ10', 'analyse-fondamentale', 'macro', 2, 'Sur le YieldCurveVisualizer, une courbe « plate » suggère :', '[{"id":"a","label":"Une croissance explosive imminente"},{"id":"b","label":"Une transition ou incertitude économique"},{"id":"c","label":"Une inflation galopante"},{"id":"d","label":"Un défaut souverain"}]'::jsonb, 'b', 'Courbe plate = marché incertain sur la direction future.', 'YieldCurveVisualizer', 'a14', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ11', 'analyse-fondamentale', 'macro', 2, 'Dans le MacroDashboard, un indicateur affichant « Beat » avec un consensus dépassé signifie :', '[{"id":"a","label":"Le réel est inférieur au consensus"},{"id":"b","label":"Le réel est supérieur au consensus"},{"id":"c","label":"Le réel égale le consensus"},{"id":"d","label":"L''indicateur est annulé"}]'::jsonb, 'b', 'Beat = réel > consensus (surprise positive).', 'MacroDashboard', 'a5', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ12', 'analyse-fondamentale', 'macro', 3, 'L''EconomicCycleWheel permet de distinguer :', '[{"id":"a","label":"Le cycle économique (phases macro) de la tendance prix (direction)"},{"id":"b","label":"Le cycle des lave-vaisselle"},{"id":"c","label":"Le PIB et l''inflation uniquement"},{"id":"d","label":"Les taux et les devises"}]'::jsonb, 'a', 'Cycle ≠ tendance. La roue montre les phases macro, pas les graphiques de prix.', 'EconomicCycleWheel', 'a1', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ13', 'analyse-fondamentale', 'macro', 3, 'Dans le FedSimulator, la combinaison CPI 5 % + NFP 300K produit probablement une décision :', '[{"id":"a","label":"Dovish (baisse des taux)"},{"id":"b","label":"Hawkish (maintien ou hausse des taux)"},{"id":"c","label":"Neutre sans changement"},{"id":"d","label":"QE illimité"}]'::jsonb, 'b', 'Inflation chaude + emploi fort = Fed restrictive.', 'FedSimulator', 'a1', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ14', 'analyse-fondamentale', 'macro', 3, 'Sur l''IntermarketCorrelationMap, une cassure de corrélation historique (gris) entre l''or et le DXY peut signaler :', '[{"id":"a","label":"Un retour à la normale"},{"id":"b","label":"Un choc systémique ou un changement de régime macro"},{"id":"c","label":"Une erreur de données"},{"id":"d","label":"Rien de particulier"}]'::jsonb, 'b', 'Décorrélation soudaine = crise ou changement de paradigme.', 'IntermarketCorrelationMap', 'a13', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.2-WQ15', 'analyse-fondamentale', 'macro', 3, 'Le NfpInterpreter croise le NFP avec les salaires horaires moyens car :', '[{"id":"a","label":"Les salaires sont décoratifs"},{"id":"b","label":"La pression salariale alimente l''inflation (spirale prix-salaires)"},{"id":"c","label":"Les salaires n''ont aucun lien avec la Fed"},{"id":"d","label":"Le NFP seul suffit"}]'::jsonb, 'b', 'NFP + salaires = lecture complète du marché du travail pour la Fed.', 'NfpInterpreter', 'a4', true);
