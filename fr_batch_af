INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.4-WQ5', 'analyse-fondamentale', 'outils', 2, 'Le DcfSimulator affiche la « valeur terminale » comme représentant :', '[{"id":"a","label":"5 % de la valorisation"},{"id":"b","label":"60-80 % de la valorisation totale"},{"id":"c","label":"La dette nette"},{"id":"d","label":"Les dividendes"}]'::jsonb, 'b', 'La majorité de la valeur vient des flux lointains.', 'DcfSimulator', 'a12', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.4-WQ6', 'analyse-fondamentale', 'outils', 2, 'Dans le ValuationLab, un multiple supérieur à la médiane sectorielle signifie :', '[{"id":"a","label":"Une décote automatique"},{"id":"b","label":"Une prime (croissance ou qualité supérieure)"},{"id":"c","label":"Une erreur de calcul"},{"id":"d","label":"Un red flag"}]'::jsonb, 'b', 'Prime justifiée par des fondamentaux supérieurs.', 'ValuationLab', 'a12', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.4-WQ7', 'analyse-fondamentale', 'outils', 2, 'Le PeerComparisonMatrix identifie un « laggard » comme :', '[{"id":"a","label":"Une entreprise avec ROE élevé et marges supérieures"},{"id":"b","label":"Une entreprise avec multiples bas et marges compressées"},{"id":"c","label":"Une entreprise en forte croissance"},{"id":"d","label":"Une entreprise sans dette"}]'::jsonb, 'b', 'Laggard = sous-performeur structurel du secteur.', 'PeerComparisonMatrix', 'a12', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.4-WQ8', 'analyse-fondamentale', 'outils', 2, 'Dans l''EarningsImpactEngine, une surprise EPS > 5 % est considérée comme :', '[{"id":"a","label":"Un bruit de marché"},{"id":"b","label":"Un fort signal"},{"id":"c","label":"Sans importance"},{"id":"d","label":"Un dividende exceptionnel"}]'::jsonb, 'b', '> 5 % = magnitude significative = réaction cours probable.', 'EarningsImpactEngine', 'a12', true);
