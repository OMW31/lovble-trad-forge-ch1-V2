INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ1', 'analyse-fondamentale', 'micro', 1, 'Le CompanyHealthScore agrège 4 dimensions. Laquelle n''est PAS incluse ?', '[{"id":"a","label":"Croissance"},{"id":"b","label":"Marges"},{"id":"c","label":"Dette"},{"id":"d","label":"Dividende"}]'::jsonb, 'd', 'Les 4 dimensions sont : Croissance, Marges, Dette, Liquidité.', 'CompanyHealthScore', 'a6', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ2', 'analyse-fondamentale', 'micro', 1, 'Dans le BalanceSheetExplorer, l''équation fondamentale est :', '[{"id":"a","label":"Actif = Passif + Equity"},{"id":"b","label":"Revenus = Bénéfices + Dividendes"},{"id":"c","label":"Dette = Actif − Cash"},{"id":"d","label":"Equity = Dette × ROE"}]'::jsonb, 'a', 'C''est la base de la comptabilité en partie double.', 'BalanceSheetExplorer', 'a8', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ3', 'analyse-fondamentale', 'micro', 1, 'Le CompanyDashboard affiche les KPI sous forme de :', '[{"id":"a","label":"Graphique en camembert"},{"id":"b","label":"Tuiles synthèse avec lecture croisée"},{"id":"c","label":"Tableau Excel brut"},{"id":"d","label":"Carte géographique"}]'::jsonb, 'b', 'C''est une vue synthèse rapide pour le diagnostic micro.', 'CompanyDashboard', 'a3', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ4', 'analyse-fondamentale', 'micro', 2, 'Un score CompanyHealthScore > 75 est interprété comme :', '[{"id":"a","label":"Un red flag immédiat"},{"id":"b","label":"Une qualité institutionnelle"},{"id":"c","label":"Une valorisation excessive"},{"id":"d","label":"Un risque de faillite"}]'::jsonb, 'b', '> 75 = entreprise solide sur les 4 dimensions.', 'CompanyHealthScore', 'a6', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ5', 'analyse-fondamentale', 'micro', 2, 'Dans le FinancialRatios, un ROE > 15 % est généralement considéré comme :', '[{"id":"a","label":"Faible"},{"id":"b","label":"De qualité institutionnelle"},{"id":"c","label":"Négatif"},{"id":"d","label":"Sans importance"}]'::jsonb, 'b', 'Seuil classique de rentabilité des fonds propres.', 'FinancialRatios', 'a7', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ6', 'analyse-fondamentale', 'micro', 2, 'Le Current Ratio dans le FinancialRatios mesure :', '[{"id":"a","label":"La rentabilité"},{"id":"b","label":"La liquidité à court terme (actifs courants / dettes courantes)"},{"id":"c","label":"L''endettement total"},{"id":"d","label":"La croissance"}]'::jsonb, 'b', '< 1 = risque de défaut à court terme.', 'FinancialRatios', 'a7', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ7', 'analyse-fondamentale', 'micro', 2, 'Dans le BalanceSheetExplorer, si Actif < Passif, l''entreprise est :', '[{"id":"a","label":"Très rentable"},{"id":"b","label":"Techniquement insolvable"},{"id":"c","label":"En croissance"},{"id":"d","label":"Sous-évaluée"}]'::jsonb, 'b', 'L''équilibre comptable est rompu = insolvabilité technique.', 'BalanceSheetExplorer', 'a8', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ8', 'analyse-fondamentale', 'micro', 2, 'Le CompanyDashboard suggère qu''un seul KPI « ne raconte rien ». Pourquoi ?', '[{"id":"a","label":"Parce que les KPI sont faux"},{"id":"b","label":"Parce qu''il faut croiser Croissance + Marges + Dette + Cash"},{"id":"c","label":"Parce que le dashboard est inutile"},{"id":"d","label":"Parce que les marchés sont efficients"}]'::jsonb, 'b', 'La microéconomie exige la lecture croisée (ex: profitable + surendetté = fragile).', 'CompanyDashboard', 'a3', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ9', 'analyse-fondamentale', 'micro', 2, 'Un D/E < 1 dans le FinancialRatios indique :', '[{"id":"a","label":"Plus de fonds propres que de dette"},{"id":"b","label":"Plus de dette que de fonds propres"},{"id":"c","label":"Une absence totale de dette"},{"id":"d","label":"Une faillite imminente"}]'::jsonb, 'a', 'Structure financière conservative.', 'FinancialRatios', 'a7', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ10', 'analyse-fondamentale', 'micro', 3, 'Pourquoi le ROE élevé via levier (dette) est-il signalé comme « fragile » dans le FinancialRatios ?', '[{"id":"a","label":"Parce que la dette augmente le risque financier en cas de choc"},{"id":"b","label":"Parce que la dette est interdite"},{"id":"c","label":"Parce que le ROE est faux"},{"id":"d","label":"Parce que les actionnaires préfèrent le cash"}]'::jsonb, 'a', 'ROE artificiellement gonflé = risque de faillite si les taux montent.', 'FinancialRatios', 'a7', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ11', 'analyse-fondamentale', 'micro', 3, 'Dans le BalanceSheetExplorer, le « Current Ratio » < 1 signifie concrètement :', '[{"id":"a","label":"L''entreprise ne peut pas couvrir ses dettes à court terme avec ses actifs liquides"},{"id":"b","label":"L''entreprise est très rentable"},{"id":"c","label":"L''entreprise a trop de cash"},{"id":"d","label":"Rien de particulier"}]'::jsonb, 'a', 'C''est un signal d''alerte de liquidité.', 'BalanceSheetExplorer', 'a8', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.3-WQ12', 'analyse-fondamentale', 'micro', 3, 'Pourquoi le CompanyHealthScore pondère-t-il la « Croissance » à 30 % et la « Liquidité » à 20 % ?', '[{"id":"a","label":"Parce que la croissance est le meilleur prédicteur de création de valeur à long terme"},{"id":"b","label":"Parce que la liquidité n''a pas d''importance"},{"id":"c","label":"Parce que les pondérations sont aléatoires"},{"id":"d","label":"Parce que la dette est plus importante"}]'::jsonb, 'a', 'La croissance est le moteur principal, mais la liquidité reste critique (20 %).', 'CompanyHealthScore', 'a6', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.4-WQ1', 'analyse-fondamentale', 'outils', 1, 'Le ValuationLab permet de tester :', '[{"id":"a","label":"Les ratios de liquidité"},{"id":"b","label":"Les multiples P/E, P/S, P/B et leur prime/décote sectorielle"},{"id":"c","label":"Les taux de change"},{"id":"d","label":"L''inflation"}]'::jsonb, 'b', 'C''est un laboratoire de valorisation par multiples.', 'ValuationLab', 'a12', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.4-WQ2', 'analyse-fondamentale', 'outils', 1, 'Dans le DcfSimulator, le paramètre le plus sensible est :', '[{"id":"a","label":"La croissance des revenus"},{"id":"b","label":"Le WACC"},{"id":"c","label":"La marge nette"},{"id":"d","label":"Le nombre d''employés"}]'::jsonb, 'b', '+1 % WACC = −15 à −20 % valorisation.', 'DcfSimulator', 'a12', true);
INSERT INTO question_bank_part_b (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, widget, visual_id, is_active) VALUES ('1.4-WQ3', 'analyse-fondamentale', 'outils', 1, 'Le PeerComparisonMatrix compare une entreprise à :', '[{"id":"a","label":"Des concurrents du même secteur"},{"id":"b","label":"Des entreprises aléatoires"},{"id":"c","label":"Des indices boursiers"},{"id":"d","label":"Des banques centrales"}]'::jsonb, 'a', 'C''est la comparaison avec des pairs (peers).', 'PeerComparisonMatrix', 'a12', true);
