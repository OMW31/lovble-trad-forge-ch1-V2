INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q6', 'analyse-fondamentale', 'macro', 2, 'Une inflation élevée et persistante peut conduire la banque centrale à :', '[{"id":"a","label":"Baisser ses taux directeurs"},{"id":"b","label":"Augmenter ses taux directeurs"},{"id":"c","label":"Ne rien changer"},{"id":"d","label":"Acheter des obligations"}]'::jsonb, 'b', 'La politique restrictive (hausse des taux) vise à réduire l''inflation.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q7', 'analyse-fondamentale', 'macro', 2, 'Parmi les indicateurs suivants, lequel est un indicateur avancé (leading) ?', '[{"id":"a","label":"Taux de chômage"},{"id":"b","label":"PIB"},{"id":"c","label":"Permis de construire"},{"id":"d","label":"IPC"}]'::jsonb, 'c', 'Les permis de construire changent avant que l''économie ne suive une tendance.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q8', 'analyse-fondamentale', 'macro', 2, 'Lequel de ces indicateurs est un indicateur coïncident ?', '[{"id":"a","label":"Spread de taux (inversion courbe)"},{"id":"b","label":"Production industrielle"},{"id":"c","label":"Coûts unitaires main-d''œuvre"},{"id":"d","label":"Nouvelles commandes équipement"}]'::jsonb, 'b', 'La production industrielle évolue approximativement en même temps que l''économie.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q9', 'analyse-fondamentale', 'macro', 2, 'Le taux de chômage est considéré comme un indicateur :', '[{"id":"a","label":"Avancé"},{"id":"b","label":"Coïncident"},{"id":"c","label":"Retardé"},{"id":"d","label":"Non fiable"}]'::jsonb, 'c', 'Les entreprises attendent d''être sûres de la reprise avant d''embaucher massivement.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q10', 'analyse-fondamentale', 'macro', 2, 'Une hausse des prix du pétrole bénéficie généralement au :', '[{"id":"a","label":"JPY"},{"id":"b","label":"CAD (Canada)"},{"id":"c","label":"EUR"},{"id":"d","label":"CHF"}]'::jsonb, 'b', 'Le Canada est exportateur net de pétrole ; une hausse améliore sa balance.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q11', 'analyse-fondamentale', 'macro', 2, 'L''« Average Hourly Earnings » aux USA mesure :', '[{"id":"a","label":"Le nombre total d''emplois"},{"id":"b","label":"L''évolution des revenus salariaux"},{"id":"c","label":"Le taux de participation"},{"id":"d","label":"La productivité"}]'::jsonb, 'b', 'Une forte croissance des salaires peut alimenter l''inflation (spirale prix-salaires).', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q12', 'analyse-fondamentale', 'macro', 2, 'Les indices PMI (Purchasing Managers'' Index) sont particulièrement surveillés car :', '[{"id":"a","label":"Ils mesurent l''inflation passée"},{"id":"b","label":"Ils donnent une indication précoce de la santé des secteurs"},{"id":"c","label":"Ils remplacent le PIB"},{"id":"d","label":"Ils sont publiés annuellement"}]'::jsonb, 'b', 'Les PMI sont des indicateurs avancés de l''activité économique.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q13', 'analyse-fondamentale', 'macro', 3, 'Quelle catégorie d''indicateurs regroupe les décisions sur les taux d''intérêt et le forward guidance ?', '[{"id":"a","label":"Indicateurs de croissance"},{"id":"b","label":"Indicateurs d''inflation"},{"id":"c","label":"Indicateurs liés à la politique monétaire"},{"id":"d","label":"Indicateurs de confiance"}]'::jsonb, 'c', 'Ce sont des événements et communications ayant un impact fondamental majeur.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q14', 'analyse-fondamentale', 'macro', 3, 'Une inversion de la courbe des taux (2Y > 10Y) est souvent interprétée comme :', '[{"id":"a","label":"Un signal de croissance forte"},{"id":"b","label":"Un signe avant-coureur de récession"},{"id":"c","label":"Une politique monétaire expansionniste"},{"id":"d","label":"Un indicateur coïncident"}]'::jsonb, 'b', 'L''inversion de la courbe est un indicateur avancé classique de récession.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.2-Q15', 'analyse-fondamentale', 'macro', 3, 'Pourquoi les anticipations de changement de taux sont souvent plus importantes que les changements eux-mêmes ?', '[{"id":"a","label":"Parce que les marchés anticipent et prixent à l''avance"},{"id":"b","label":"Parce que les banques centrales ne changent jamais les taux"},{"id":"c","label":"Parce que les taux sont fixes"},{"id":"d","label":"Parce que les anticipations n''ont aucun impact"}]'::jsonb, 'a', 'Les marchés fonctionnent par anticipation ; le « priced in » est central.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q1', 'analyse-fondamentale', 'micro', 1, 'Les données microéconomiques se concentrent principalement sur :', '[{"id":"a","label":"La politique monétaire"},{"id":"b","label":"Les performances individuelles des entreprises"},{"id":"c","label":"Les taux de change"},{"id":"d","label":"Les indicateurs de confiance"}]'::jsonb, 'b', 'La microéconomie analyse les unités économiques individuelles (entreprises, ménages).', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q2', 'analyse-fondamentale', 'micro', 1, 'Le bilan d''une entreprise respecte toujours l''équation :', '[{"id":"a","label":"Actif = Passif − Equity"},{"id":"b","label":"Actif = Passif + Equity"},{"id":"c","label":"Equity = Passif − Actif"},{"id":"d","label":"Passif = Actif + Equity"}]'::jsonb, 'b', 'Actif = Passif + Equity (fondamental de la comptabilité).', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q3', 'analyse-fondamentale', 'micro', 1, 'Le compte de résultat mesure :', '[{"id":"a","label":"La santé financière à un instant T"},{"id":"b","label":"La performance sur une période (revenus, coûts, bénéfices)"},{"id":"c","label":"Les flux de trésorerie"},{"id":"d","label":"La valeur de l''entreprise"}]'::jsonb, 'b', 'Il présente les revenus et charges sur une période donnée.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q4', 'analyse-fondamentale', 'micro', 1, 'Une marge nette de 25 % signifie que :', '[{"id":"a","label":"L''entreprise dégage 25 % de bénéfice net par rapport à ses revenus"},{"id":"b","label":"L''entreprise a 25 % de dette"},{"id":"c","label":"25 % des actifs sont liquides"},{"id":"d","label":"Le ROE est de 25 %"}]'::jsonb, 'a', 'Marge nette = Bénéfice net / Revenus.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q5', 'analyse-fondamentale', 'micro', 1, 'Le ratio dette/équité (D/E) évalue :', '[{"id":"a","label":"La rentabilité"},{"id":"b","label":"Le niveau d''endettement"},{"id":"c","label":"La liquidité"},{"id":"d","label":"La croissance des ventes"}]'::jsonb, 'b', 'Il indique le niveau d''endettement par rapport aux fonds propres.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q6', 'analyse-fondamentale', 'micro', 1, 'Le ROE (Return on Equity) mesure :', '[{"id":"a","label":"La rentabilité des capitaux propres"},{"id":"b","label":"La liquidité de l''entreprise"},{"id":"c","label":"L''endettement total"},{"id":"d","label":"La croissance des revenus"}]'::jsonb, 'a', 'ROE = Bénéfice net / Capitaux propres.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q7', 'analyse-fondamentale', 'micro', 2, 'Un flux de trésorerie libre (Free Cash Flow) élevé indique :', '[{"id":"a","label":"Une forte capacité à générer de la liquidité disponible"},{"id":"b","label":"Une forte dette"},{"id":"c","label":"Une faible rentabilité"},{"id":"d","label":"Un besoin de financement externe"}]'::jsonb, 'a', 'Le FCF représente la liquidité générée après investissements.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q8', 'analyse-fondamentale', 'micro', 2, 'Apple Inc. affichait en 2023 une marge nette de 25 % et un P/E de 28. Cela suggère :', '[{"id":"a","label":"Une valorisation juste proche de la valeur intrinsèque"},{"id":"b","label":"Une entreprise en difficulté"},{"id":"c","label":"Un ratio D/E élevé"},{"id":"d","label":"Une faible croissance"}]'::jsonb, 'a', 'Marge élevée + P/E raisonnable = valorisation alignée avec les fondamentaux.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q9', 'analyse-fondamentale', 'micro', 2, 'Tesla affichait en 2022 un P/E de 50+. Cela reflète principalement :', '[{"id":"a","label":"Une valorisation discount"},{"id":"b","label":"Des attentes de croissance futures très élevées"},{"id":"c","label":"Une faible volatilité"},{"id":"d","label":"Un endettement nul"}]'::jsonb, 'b', 'Un P/E élevé indique que le marché anticipe une forte croissance future.', true);
INSERT INTO question_bank_part_a (question_key, chapter_id, lesson_id, difficulty, prompt, choices, correct_id, explanation, is_active) VALUES ('1.3-Q10', 'analyse-fondamentale', 'micro', 2, 'Le « Current Ratio » (actifs courants / dettes courantes) mesure :', '[{"id":"a","label":"La rentabilité à long terme"},{"id":"b","label":"La liquidité et la capacité à payer les dettes à court terme"},{"id":"c","label":"L''efficacité opérationnelle"},{"id":"d","label":"La croissance des ventes"}]'::jsonb, 'b', '< 1 = risque de défaut à court terme.', true);
